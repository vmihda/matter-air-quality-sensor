menu "Air quality sensor"

    choice AQ_BUILD_MODE
        prompt "Firmware mode"
        default AQ_MODE_PRODUCT

        config AQ_MODE_PRODUCT
            bool "Product firmware"

        config AQ_BRINGUP
            bool "Sensor bring-up without Matter"

        config AQ_DEMO_VALUES
            bool "Matter with demo values for the Apple Home check"

    endchoice

    config AQ_DEVICE_NAME
        string "Network name of this unit"
        default "aq-sensor"

    config AQ_WEB_PASSWORD
        string "Device page password of this unit"
        default ""
        help
            The device page stays off while this is empty.

endmenu
